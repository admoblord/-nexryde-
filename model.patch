-------------------+        async function loadVerifications() {
-------------------+            try {
-------------------+                const res = await fetch(`${API_URL}/admin/verifications`);
-------------------+                const data = await res.json();
-------------------+                
-------------------+                const pendingCount = data.verifications?.filter(v => v.status === 'pending').length || 0;
