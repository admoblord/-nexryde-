{
  "name": "frontend",
  "main": "./index.ts",
  "version": "1.3.33",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "cache:expo": "rm -rf .expo",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:core": "bash ../scripts/verify_core.sh",
    "verify:routes": "node ./scripts/verify_expo_routes.mjs",
    "verify:tracking-animation": "node ./scripts/verify_tracking_animation.mjs",
    "verify:go-offline": "node ./scripts/validate_driver_go_offline_optimistic.mjs",
    "verify:rider-profile": "node ./scripts/validate_rider_profile_hydrate.mjs",
    "verify:location-instant": "node ./scripts/validate_location_instant.mjs",
    "verify:places-instant": "node ./scripts/validate_places_instant.mjs",
    "verify:places-cache": "node --experimental-strip-types --no-warnings ./scripts/validate_places_cache_behavior.mjs",
    "verify:place-labels": "node --experimental-strip-types --no-warnings ./scripts/validate_place_label_quality.mjs",
    "verify:places-resilience": "node --experimental-strip-types --no-warnings ./scripts/validate_places_search_resilience.mjs",
    "verify:go-online-race": "node ./scripts/validate_driver_go_online_race.mjs",
    "verify:driver-status-standard": "node ./scripts/validate_driver_status_uber_standard.mjs",
    "verify:app-store-ipad-audio": "node ./scripts/validate_app_store_ipad_audio.mjs",
    "verify:network-state": "node ./scripts/validate_network_state_manager.mjs",
    "verify:network-device": "node ./scripts/android_network_device_validation.mjs",
    "verify:network-device:guided": "node ./scripts/android_network_device_validation.mjs --guided",
    "verify:app": "npx tsc --noEmit && node ./scripts/verify_expo_routes.mjs && node ./scripts/validate_driver_go_offline_optimistic.mjs && node ./scripts/validate_rider_profile_hydrate.mjs && node ./scripts/validate_location_instant.mjs && node ./scripts/validate_network_state_manager.mjs",
    "verify:appearance-native": "node ./scripts/apply_appearance_native_patch.cjs --verify-only --require-success",
    "postinstall": "node ./scripts/apply_appearance_native_patch.cjs --require-success",
    "verify:map-engines": "node ./scripts/verify_map_engines.mjs",
    "verify:rider-map": "node ./scripts/verify_rider_map_parity.mjs",
    "verify:trip-uber": "node ./scripts/verify_trip_uber_upgrades.mjs",
    "verify:driver-trip": "node ./scripts/verify_driver_trip_uber.mjs",
    "verify:driver-nav": "node ./scripts/verify_driver_navigation_choice.mjs",
    "verify:firebase-android": "node ./scripts/verify_firebase_android_config.mjs",
    "verify:android-release-startup": "node ./scripts/verify_android_release_startup.mjs",
    "verify:android-16kb": "node ./scripts/verify_android_16kb_config.mjs",
    "verify:android-16kb-aab": "node ./scripts/verify_android_16kb_aab.mjs",
    "verify:driver-fgs-login": "node ./scripts/verify_driver_fgs_login_crash.mjs",
    "verify:legal-terms": "node ./scripts/verify_legal_terms_stability.mjs",
    "screenshots:ios": "node ./scripts/generate-app-store-screenshots.mjs",
    "screenshots:ipad13": "node ./scripts/generate-ipad-13-screenshots.mjs",
    "deploy:backend": "bash ../scripts/deploy_backend.sh",
    "ship:check": "bash ../scripts/one_click_ship.sh check",
    "ship:all": "bash ../scripts/one_click_ship.sh all",
    "build:local:apk": "./scripts/local-android-build.sh apk",
    "build:local:aab": "./scripts/local-android-build.sh aab",
    "build:eas:android": "eas build --platform android --profile production",
    "build:eas:android:aab": "eas build --platform android --profile production --non-interactive",
    "build:eas:android:aab:clear": "eas build --platform android --profile production --clear-cache --non-interactive",
    "build:eas:android:apk": "eas build --platform android --profile preview",
    "build:eas:android:apk:clear": "eas build --platform android --profile preview --clear-cache",
    "submit:android": "eas submit --platform android --profile production --latest",
    "build:eas:ios": "eas build --platform ios --profile production --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production --latest --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@googlemaps/react-native-navigation-sdk": "^0.16.3",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.13.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-av": "^16.0.8",
    "expo-blur": "^15.0.8",
    "expo-build-properties": "^57.0.3",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-cronet": "^0.2.7",
    "expo-device": "^8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "^19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "puppeteer": "^23.11.1",
    "react-native-dotenv": "^3.4.11",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true,
  "packageManager": "npm@11.6.2"
}
