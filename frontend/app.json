{
  "expo": {
    "name": "NEXRYDE",
    "slug": "nexryde",
    "version": "1.3.37",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexryde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "BACKEND_URL": "https://nexryde-backend-993913300770.africa-south1.run.app",
      "eas": {
        "projectId": "342aff56-5e09-4363-b8b6-12ab1cdec11f"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexryde.app",
      "config": {
        "googleMapsApiKey": ""
      },
      "buildNumber": "68",
      "associatedDomains": [
        "applinks:nexryde.app",
        "webcredentials:nexryde.app"
      ],
      "requireFullScreen": true,
      "backgroundColor": "#0D1420",
      "infoPlist": {
        "CFBundleDisplayName": "NEXRYDE",
        "CFBundleName": "NEXRYDE",
        "CFBundleShortVersionString": "1.3.37",
        "CFBundleVersion": "68",
        "NSLocationWhenInUseUsageDescription": "NEXRYDE uses your location to show nearby drivers, estimate pickup times, and track your trip in real time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NEXRYDE uses your location in the background so drivers can share their position with riders and receive new trip requests while the app is minimised.",
        "NSLocationAlwaysUsageDescription": "NEXRYDE uses your location in the background so drivers can share their position with riders and receive new trip requests while the app is minimised.",
        "NSCameraUsageDescription": "NEXRYDE uses the camera for driver document verification, profile photos, and biometric withdrawal confirmation.",
        "NSPhotoLibraryUsageDescription": "NEXRYDE needs access to your photos to let you upload a profile picture or driver documents.",
        "NSPhotoLibraryAddUsageDescription": "NEXRYDE may save trip receipts or screenshots to your photo library.",
        "NSMicrophoneUsageDescription": "NEXRYDE uses the microphone only when you choose to record trip evidence for safety review.",
        "NSFaceIDUsageDescription": "NEXRYDE uses Face ID to verify your identity for secure login and biometric withdrawals.",
        "NSContactsUsageDescription": "NEXRYDE reads your contacts so you can quickly book a ride for someone else.",
        "NSMotionUsageDescription": "NEXRYDE uses device motion sensors for the emergency shake-to-alert safety feature.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "maps",
          "comgooglemaps",
          "waze",
          "uber",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 296,
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_KEY_REDACTED"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1420"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nexryde.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nexryde.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nexryde",
              "host": "invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withSafeAppearanceTurboModule.js",
      "./plugins/withDriverExperiencePackage.js",
      [
        "expo-cronet",
        {
          "provider": "play-services",
          "enableBrotli": true,
          "enableQuic": true,
          "enableHttp2": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsc.so"
              ]
            },
            "usesCleartextTraffic": false
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NEXRYDE uses your location to show nearby drivers, estimate pickup times, and track your trip in real time.",
          "locationAlwaysAndWhenInUsePermission": "NEXRYDE uses your location in the background so drivers can share their position with riders and receive new trip requests while the app is minimised.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1420"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NEXRYDE to use Face ID for secure login and biometric withdrawals."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#22E180",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/driver_offer_1.m4a",
            "./assets/sounds/driver_offer_2.m4a",
            "./assets/sounds/driver_offer_3.mp3",
            "./assets/sounds/driver_offer_4.mp3"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NEXRYDE needs access to your photos to let you upload a profile picture or driver documents.",
          "cameraPermission": "NEXRYDE uses the camera for driver document verification, profile photos, and biometric withdrawal confirmation."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "josephbbs1",
    "primaryColor": "#22E180"
  }
}
