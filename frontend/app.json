{
  "expo": {
    "name": "NEXRYDE",
    "slug": "nexryde",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexryde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "BACKEND_URL": "https://nexryde-backend-993913300770.us-central1.run.app",
      "eas": {
        "projectId": "342aff56-5e09-4363-b8b6-12ab1cdec11f"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexryde.app",
      "associatedDomains": ["applinks:nexryde.app"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NexRyde uses your location to detect your pickup point and match you with nearby drivers.",
        "NSCameraUsageDescription": "NEXRYDE needs camera access for document verification",
        "NSSpeechRecognitionUsageDescription": "Book rides with your voice - Nigerian accent supported",
        "NSMicrophoneUsageDescription": "Voice booking needs microphone access"
      }
    },
    "android": {
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1420"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nexryde.app",
      "jsEngine": "hermes",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nexryde.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nexryde",
              "host": "invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NexRyde uses your location to detect your pickup point and match you with nearby drivers.",
          "locationAlwaysAndWhenInUsePermission": "NexRyde uses your location to detect your pickup point and match you with nearby drivers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1420"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NEXRYDE to use Face ID for secure login"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NEXRYDE to use microphone for voice booking.",
          "speechRecognitionPermission": "Allow NEXRYDE to recognize speech for voice booking.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "josephbbs1",
    "primaryColor": "#22E180"
  }
}