# Copy to frontend/.env for local development (never commit .env).

# Public API base (no secret).
EXPO_PUBLIC_BACKEND_URL=https://nexryde-backend-993913300770.us-central1.run.app

# Client-side Maps keys: use SEPARATE keys from the backend GOOGLE_MAPS_API_KEY.
# Android key must have Maps SDK for Android enabled and be restricted to:
#   package: com.nexryde.app
#   SHA-1: Play App Signing certificate SHA-1 and/or EAS upload certificate SHA-1
# For EAS builds, set as a project secret so it never lives in git:
#   npx eas-cli secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY --value "YOUR_ANDROID_SDK_KEY" --type string
#   npx eas-cli secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value "YOUR_DIRECTIONS_OR_GENERAL_KEY" --type string
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional paid raster tile fallback. Do NOT use https://*.tile.openstreetmap.org
# for production ride-hailing traffic. Leave blank unless using a contracted provider
# such as MapTiler, Mapbox Raster Tiles, Stadia Maps, Thunderforest, etc.
EXPO_PUBLIC_MAP_TILE_PROVIDER_NAME=
EXPO_PUBLIC_MAP_TILE_URL_TEMPLATE=

# ── Advanced map engines (require native EAS rebuild) ───────────────────────
# Google Navigation SDK — Uber-class driver turn-by-turn (lanes/speed/reroute).
# Enable Navigation SDK API on the same (or dedicated) Maps key + billing/SKU.
EXPO_PUBLIC_GOOGLE_NAVIGATION_ENABLED=true

# MapLibre GPU heatmaps + optional offline packs (Studio/vector styles).
EXPO_PUBLIC_MAPLIBRE_ENABLED=true
# Optional style JSON (MapLibre / MapTiler / Mapbox Studio style URL).
# Default: https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=
# If using a Mapbox Studio style (mapbox://...), set token:
EXPO_PUBLIC_MAPBOX_STYLE_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
