# Copy to frontend/.env for local development (never commit .env).

# Public API base (no secret).
EXPO_PUBLIC_BACKEND_URL=https://nexryde-backend-993913300770.us-central1.run.app

# Client-side Maps key: use a SEPARATE key from the backend GOOGLE_MAPS_API_KEY.
# Restrict in Google Cloud Console (Android: package com.nexryde.app; iOS: your bundle id).
# For EAS builds, set as a project secret so it never lives in git:
#   npx eas-cli secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value "YOUR_KEY" --type string
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
