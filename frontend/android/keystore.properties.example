# Copy this file to: android/keystore.properties
# NEVER commit keystore.properties or your .jks file to git.
#
# Prefer Expo to handle Play signing? From frontend/ run:
#   npx eas-cli login
#   npm run build:eas:android
# (production profile = store AAB + release signing on Expo servers)

# 1) Generate a Play upload keystore (one-time, pick strong passwords and BACK THEM UP):
#
#    cd frontend/android/app
#    keytool -genkeypair -v -storetype PKCS12 \
#      -keystore nexryde-upload-key.jks \
#      -alias nexryde-upload \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2) In Play Console → App signing, use "Let Google manage your app signing" and upload this key as the upload key.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=nexryde-upload
# Path is relative to the android/ folder (same folder as this example file).
storeFile=app/nexryde-upload-key.jks
