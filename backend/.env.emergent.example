# Emergent / non-Cloud-Run production template.
# Copy to backend/.env on the host. Never commit the real file.
#
# Before traffic:
#   1. Add this host's egress IP to MongoDB Atlas Network Access
#      (Cloud Run used 34.35.108.112 — Emergent is different)
#   2. curl https://<host>/api/health and /api/health/ready
#   3. Point NEXRYDE_PUBLIC_BACKEND_URL here (Squad callbacks use it)
#   4. Change frontend/backend.config.json "origin" and rebuild the app
# See MIGRATION_OFF_CLOUD_RUN.md.

NEXRYDE_ENV=production
ENVIRONMENT=production

MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=nexryde
DB_NAME=nexryde_db
JWT_SECRET=replace-me

# TrustedHostMiddleware returns 400 unless the request Host is listed.
TRUSTED_HOSTS=your-app.emergent.host
CORS_ORIGINS=https://nexryde.app,exp://,nexryde://

# Memorystore is VPC-only. Off Cloud Run either disable the hard requirement
# (in-memory fallback — fine for a single process) or point at Upstash/Redis Cloud.
REDIS_REQUIRED=false
# REDIS_URL=rediss://default:PASSWORD@YOUR_UPSTASH_HOST:6379

# Public URL of THIS backend. Squad CallBack_URL is built from it.
NEXRYDE_PUBLIC_BACKEND_URL=https://your-app.emergent.host

GOOGLE_MAPS_API_KEY=
NEXRYDE_OPS_KEY=

# FCM: Emergent has no Cloud Run secret volume. Prefer base64 of the service
# account JSON (written to /tmp at startup), or a file path on the host.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# GCS driver documents (optional — falls back to base64-in-Mongo when unset)
# GCS_MEDIA_BUCKET=nexryde-media

SQUAD_SECRET_KEY=
SQUAD_PUBLIC_KEY=
SQUAD_WEBHOOK_SECRET=
SQUAD_BASE_URL=https://api-d.squadco.com
SQUAD_CHECKOUT_BASE_URL=https://pay.squadco.com

BREVO_API_KEY=
# TERMII_API_KEY=

# Cron on the host (every 2 min) replaces Cloud Scheduler:
#   curl -X POST -H "X-NEXRYDE-OPS-KEY: $NEXRYDE_OPS_KEY" \
#     "$NEXRYDE_PUBLIC_BACKEND_URL/api/ops/maintenance-tick"
