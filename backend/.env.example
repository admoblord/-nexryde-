# Copy to backend/.env locally (never commit .env). Production uses Cloud Run env vars.

MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=nexryde
DB_NAME=nexryde_db

# Server-only Google key (Places, Routes, etc.) — not the same as EXPO_PUBLIC_* client key.
GOOGLE_MAPS_API_KEY=

TERMII_API_KEY=
TERMII_FROM_ID=NEXRYDE
TERMII_BASE_URL=https://v3.api.termii.com

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
OPENAI_API_KEY=
EMERGENT_LLM_KEY=
