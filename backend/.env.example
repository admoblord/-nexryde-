# Copy to backend/.env locally (never commit .env). Production hosts on Emergent
# — see backend/.env.emergent.example.

MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=nexryde
# Staging Atlas M0 (separate cluster — never production):
# MONGODB_URI_STAGING=mongodb+srv://USER:PASSWORD@STAGING_CLUSTER.mongodb.net/?appName=nexryde-staging
# DB_NAME on staging is typically nexryde_staging_db when using a separate Atlas cluster.
DB_NAME=nexryde_db

# ── Email OTP (POST /api/auth/email-otp/request)
# Option A — Brevo REST (recommended): API key + verified sender in Brevo dashboard.
BREVO_API_KEY=
# Use a sender email verified in Brevo (or set EMAIL_OTP_FROM to the same address).
# BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
# BREVO_SENDER_NAME=NEXRYDE
# BREVO_API_BASE=https://api.brevo.com/v3
#
# Brevo powers: legacy email-OTP (HTML), unified OTP, driver verification email, admin 2FA email,
# registration welcome, enforcement violations, trip receipts (paid trips), subscription payment reminders,
# vehicle verification outcomes from admin, and optional duplicates of push alerts (see NOTIFICATION_EMAIL_MIRROR).
#
# Duplicate selected push notifications to inbox (respects user notification_channels.email).
# Trip assignment pings are excluded unless NOTIFICATION_EMAIL_MIRROR_TRIPS=true (high volume).
# NOTIFICATION_EMAIL_MIRROR=true
# NOTIFICATION_EMAIL_MIRROR_TRIPS=false
#
# Trip receipt emails send automatically once payment_status becomes completed (field receipt_email_sent_at on trips prevents duplicates).

# Option B — SMTP fallback (only when BREVO_API_KEY is empty).
# Legacy /mongo email-OTP path (`/api/auth/email-otp/*`) will use SMTP; unified OTP (`/api/auth/otp/*`) requires REST + BREVO_API_KEY.
#
# Brevo SMTP relay (from Brevo → SMTP & API → SMTP tab):
#   Host: smtp-relay.brevo.com
#   Port: 587 (STARTTLS) — leave SMTP_USE_SSL unset or false
#   Login: your-xxxxxx@smtp-brevo.com — copy from dashboard
#   Password: the SMTP key shown in Brevo (not your Brevo login password)
# Sender in “From” header must be a verified/domain sender in Brevo (same idea as BREVO_SENDER_EMAIL).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OTP_FROM=

# Unified branded email OTP (POST /api/auth/otp/*) — in-memory per process; use Redis in production.
# BREVO_OTP_PEPPER=optional-pepper-for-otp-hashing  # defaults to JWT_SECRET

# Server-only Google key (Places, Routes, etc.) — not the same as EXPO_PUBLIC_* client key.
GOOGLE_MAPS_API_KEY=

# Phone SMS OTP: set SMS_OTP_MOCK=true for local/dev — OTP stored and logged, not sent.
# Production: leave false and use email sign-in, or wire another SMS provider.
SMS_OTP_MOCK=false

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Daily timed pushes (7:30 / 12:15 / 17:45 / 22:30 local). Off until you opt in at scale (~500+ active users).
# DAILY_SLOT_NOTIFICATIONS_ENABLED=true
# DAILY_SLOT_TIMEZONE=Africa/Lagos
# DAILY_SLOT_AUDIENCE=all
# DAILY_SLOT_MESSAGES_JSON=[{"id":"morning","hour":7,"minute":30,"title":"...","body":"...","action":"open_booking"}]

# Native FCM delivery for non-Expo tokens.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 on Emergent (written to /tmp).
# Or set a file path on the host:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Redis: set REDIS_REQUIRED=false for in-memory fallback on a single process,
# or point REDIS_URL at Upstash. See backend/.env.emergent.example.
# REDIS_REQUIRED=false
# REDIS_URL=redis://localhost:6379

# TrustedHostMiddleware — required in production or every request is 400.
# TRUSTED_HOSTS=nexryde-modular.preview.emergentagent.com
# Public URL used for Squad payment callbacks:
# NEXRYDE_PUBLIC_BACKEND_URL=https://nexryde-modular.preview.emergentagent.com
# CORS_ORIGINS=https://nexryde.app,exp://,nexryde://

# Private GCS bucket for driver document binaries (admin View / Download).
# GCS_MEDIA_BUCKET=nexryde-media

# Engagement push loop (driver/rider smart reminders). Off by default — enable once push/token data is production-ready.
# ENGAGEMENT_LOOP_ENABLED=true
# ENGAGEMENT_MAX_PER_DAY=2
# ENGAGEMENT_MIN_HOURS_BETWEEN=6
# ENGAGEMENT_SLOT_WINDOW_MINUTES=5
# ENGAGEMENT_DEFAULT_TIMEZONE=Africa/Lagos
# ENGAGEMENT_QUIET_HOURS_START=22
# ENGAGEMENT_QUIET_HOURS_END=7
# ENGAGEMENT_RIDER_RECENT_TRIP_HOURS=4
# ENGAGEMENT_VARIANT_HISTORY_DAYS=14
# ENGAGEMENT_DEMAND_RADIUS_KM=5
# ENGAGEMENT_MIN_PENDING_DEMAND=2
# ENGAGEMENT_MIN_ONLINE_DRIVERS_AVAILABILITY=3
# ENGAGEMENT_SCAN_LIMIT=25000
# ENGAGEMENT_SEND_CONCURRENCY=25
# ENGAGEMENT_WEATHER_ENABLED=false
# ENGAGEMENT_PROMO_ENABLED=false
# Optional global A/B key. Prefer setting experiment_key per rule in admin engagement-config.
# ENGAGEMENT_AB_EXPERIMENT_KEY=
# Optional override if you don't use the admin engagement-config API:
# ENGAGEMENT_RULES_JSON=[{"id":"driver_morning_rush","role":"driver","kind":"driver_morning_rush","days":"weekday","start":"06:00","end":"09:00","preferred_minute":15,"title":"Morning rush is starting in {area}","body":"Go online now to catch commute requests around {area}.","action":"open_driver_home"}]
