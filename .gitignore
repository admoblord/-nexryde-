# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Credential / token files (never commit real paths)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
.cursor/debug-*.log

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/
.venv_deploy_test/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db
backend/backups/

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Local env / secrets (never commit real values)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.emergent.example

# Expo / Metro (never commit cache)
frontend/.metro-cache/
backend/.secrets/

# Generated by scripts/apply_appearance_native_patch.cjs on install; not source.
frontend/ios/NEXRYDE/NexRydeAppearancePatch.proof
